{
  "name": "agent-emblem",
  "version": "0.1.0",
  "description": "Turn SVG or PNG logos into animated particle emblems for React agents.",
  "author": "Polo Garcia (https://pologarcia.is)",
  "license": "MIT",
  "homepage": "https://agent-emblem.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pologarcia/agent-emblem.git"
  },
  "bugs": {
    "url": "https://github.com/pologarcia/agent-emblem/issues"
  },
  "keywords": [
    "react",
    "ai",
    "agent",
    "animation",
    "canvas",
    "logo",
    "particles",
    "svg"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.lib.json",
    "build:site": "tsc -b && vite build --config vite.site.config.ts && vite build --config vite.ssr.config.ts && node scripts/prerender-site.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run build:site",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
